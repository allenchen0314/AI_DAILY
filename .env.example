# Resend API key (https://resend.com/api-keys) - 必需
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# 发件人邮箱 - 使用 Resend 验证过的域名,或测试用 onboarding@resend.dev
MAIL_FROM=AI Daily <onboarding@resend.dev>

# 收件人邮箱 (多个用逗号分隔)
MAIL_TO=chenzhipengsr43@gmail.com

# 智谱 AI API key (https://open.bigmodel.cn/) - 用于生成中文总结
# 不填则不附带总结,只发送新闻列表
ZHIPU_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx.xxxxxxxxxxxxxx

# 可选:覆盖默认智谱模型
# ZHIPU_MODEL=glm-4-flash

# 时区 (用于"前一天"的日期判断,默认上海)
TIMEZONE=Asia/Shanghai
